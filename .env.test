SESSION_DRIVER=memory

# In-memory rate limiter so throttle counters (e.g. the auth brute-force
# guard on POST /login and /signup) reset with each test process instead of
# persisting in Redis across runs, which would make throttled specs flaky.
LIMITER_STORE=memory

# Tests run against their own database, kept empty between runs by the
# per-test global transaction (tests/bootstrap.ts). Never point this at the
# dev database `app` — several specs assert on unscoped table counts and
# would break against seeded/real data.
DB_DATABASE=app_test
