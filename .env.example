# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Process type for the Docker entrypoint: web | queue | scheduler (default: web)
PROCESS_TYPE=web
# queue process only, optional: comma-separated queue names (default: all queues)
QUEUE_NAMES=

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

LIMITER_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Default mail - optional if custom smtp added in project
MAIL_MAILER=smtp
MAIL_FROM_NAME=Your name
MAIL_FROM_ADDRESS=app@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional - needed only to clone an email into another language
GOOGLE_TRANSLATE_API_KEY=
