<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
  </head>
  <body style="font-family: sans-serif; color: #111827; background-color: #f9fafb; padding: 24px">
    <table role="presentation" width="100%" style="max-width: 480px; margin: 0 auto">
      <tr>
        <td style="background-color: #ffffff; border-radius: 8px; padding: 32px">
          <h1 style="font-size: 18px; margin: 0 0 16px">{{ brandName }}</h1>

          <p style="font-size: 15px; line-height: 1.5">
            <strong>{{ inviterName }}</strong> invited you to join
            <strong>{{ organizationName }}</strong> as <strong>{{ role }}</strong>.
          </p>

          <p style="margin: 24px 0">
            <a
              href="{{ acceptUrl }}"
              style="background-color: #111827; color: #ffffff; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-size: 14px"
            >
              Accept invitation
            </a>
          </p>

          <p style="font-size: 13px; color: #6b7280">
            If the button doesn't work, copy this link into your browser:<br />
            <a href="{{ acceptUrl }}">{{ acceptUrl }}</a>
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
